---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CopyCommand from '../components/CopyCommand.astro';
import { app } from '../data/site';

// The hero screen: a steady 2.4:1 loop of the top of a Mac screen, cut by film/build-hero.py.
const hero = {
  still: '/media/hero/still.jpg',
  video: { webm: '/media/hero/hero.webm', mp4: '/media/hero/hero.mp4', small: '/media/hero/hero-960.mp4' },
};

// From the app's README, one line each.
const features = [
  { icon: 'wave', title: 'Music', text: 'Album art, controls and a live audio visualizer.' },
  { icon: 'cpu', title: 'AI usage', text: 'Your Claude and ChatGPT limits, before you hit them.' },
  { icon: 'resize', title: 'Custom HUDs', text: 'Volume, brightness and keyboard backlight, in the notch.' },
  { icon: 'tray', title: 'Shelf', text: 'Drop files on the notch, then drag or AirDrop them out.' },
  { icon: 'bulb', title: 'Extensions', text: 'Automations described in plain English. No code.' },
  { icon: 'calendar', title: 'Calendar & Reminders', text: 'What’s coming up, at a glance.' },
  { icon: 'fan', title: 'Fan & thermal', text: 'Fan speed, CPU temperature and a fan curve editor.' },
  { icon: 'coffee', title: 'Caffeine', text: 'Keep your Mac awake from the notch.' },
  { icon: 'downloads', title: 'Downloads', text: 'Track in-progress browser downloads.' },
  { icon: 'camera', title: 'Mirror', text: 'A quick webcam check before a call.' },
  { icon: 'battery', title: 'Battery', text: 'Charging status and percentage.' },
  { icon: 'gesture', title: 'Gestures', text: 'Swipe to open and close.' },
  { icon: 'glass', title: 'Liquid Glass', text: 'An optional glass notch on macOS 26.' },
  { icon: 'lyrics', title: 'Lyrics', text: 'Optional lyrics for what’s playing.' },
  { icon: 'laptop', title: 'Any Mac', text: 'Draws its own notch if yours has none.' },
  { icon: 'github', title: 'Open source', text: 'Free, GPL-3.0, built on boring.notch.' },
] as const;
---

<Base
  title="DynamicNotch: make your MacBook's notch actually useful"
  description="DynamicNotch turns your MacBook's notch into a live dashboard: music, AI usage limits, HUDs, a file shelf, fan and CPU stats, and automations in plain English. Free and open source."
  image={hero.still}
>
  <section class="container hero">
    <h1>{app.tagline}</h1>
    <p class="lede">Music, AI usage, HUDs, a file shelf and more, in the space that was doing nothing.</p>
    <div class="actions">
      <a class="btn btn-primary" href={app.download}><Icon name="download" size={16} /> Download for Mac</a>
      <a class="btn" href={app.repo} target="_blank" rel="noopener"><Icon name="github" size={16} /> View on GitHub</a>
    </div>
    <p class="hero-note muted">Free and open source · {app.requirements}</p>

    <div class="screen">
      {hero.video ? (
        <video data-autoplay muted loop playsinline preload="auto" poster={hero.still} width="1920" height="800"
          aria-label="DynamicNotch in use: the notch opens to Now Playing, skips a track, then shows the file shelf, system stats and AI usage before closing again.">
          <source src={hero.video.small} type="video/mp4" media="(max-width: 700px)" />
          <source src={hero.video.webm} type="video/webm" />
          <source src={hero.video.mp4} type="video/mp4" />
        </video>
      ) : (
        <img src={hero.still} width="1920" height="800" alt="The DynamicNotch notch open at the top of a Mac screen, showing a song playing next to a small calendar." />
      )}
    </div>
  </section>

  <section class="container section" id="features" aria-labelledby="features-title">
    <h2 id="features-title" class="sr-only">Features</h2>
    <ul class="features">
      {features.map(f => (
        <li>
          <Icon name={f.icon} size={26} />
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container narrow section" id="install" aria-labelledby="install-title">
    <h2 id="install-title" class="block-title">Install</h2>
    <div class="install">
      <article class="card install-card">
        <h3>Download</h3>
        <ol class="steps">
          <li>Download <a class="inline" href={app.download}>DynamicNotch.dmg</a> and drag the app to Applications.</li>
          <li>
            Run this once in Terminal to clear the macOS security warning:
            <CopyCommand command={app.unquarantine} label="Copy the Terminal command" />
          </li>
          <li>Open DynamicNotch.</li>
        </ol>
      </article>
      <article class="card install-card">
        <h3>Homebrew</h3>
        <p class="muted">One command, and it skips the security warning.</p>
        <CopyCommand command={app.brew} label="Copy the Homebrew command" />
      </article>
    </div>
    <p class="muted install-note">Any Mac on {app.requirements} works. Need help? See <a class="inline" href="/support">Support</a>.</p>
  </section>
</Base>

<style>
  /* Hero: centred, then one wide screen with the notch fixed at the top. */

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 80px;
    text-align: center;
  }

  .hero h1 {
    max-width: 14ch;
    font-size: clamp(42px, 6.4vw, 76px);
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .lede {
    max-width: 46ch;
    margin-top: 20px;
    font-size: 19px;
    color: var(--text-2);
  }

  .hero .actions {
    justify-content: center;
    margin-top: 28px;
  }

  .hero-note {
    margin-top: 14px;
    font-size: 14px;
  }

  .screen {
    width: 100%;
    margin-top: 56px;
    overflow: hidden;
    border-radius: calc(var(--radius) + 6px);
    border: 1px solid var(--border-strong);
    background: #000;
    box-shadow: 0 40px 100px -40px rgb(0 0 0 / 0.9);
  }

  .screen img,
  .screen video {
    width: 100%;
    height: auto;
    aspect-ratio: 12 / 5;
    object-fit: cover;
    object-position: top center;
  }

  /* Features: a quiet icon grid. */

  .features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 44px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features li :global(svg) {
    color: var(--accent);
  }

  .features h3 {
    margin-top: 14px;
    font-size: 17px;
    letter-spacing: -0.015em;
  }

  .features p {
    margin-top: 4px;
    font-size: 14.5px;
    color: var(--text-2);
  }

  /* Install */

  .block-title {
    margin-bottom: 20px;
    font-size: 24px;
    letter-spacing: -0.025em;
  }

  .install {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }

  .install-card {
    display: grid;
    gap: 14px;
    padding: 22px;
  }

  .install-card h3 {
    font-size: 17px;
  }

  .steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0 0 0 1.2em;
    color: color-mix(in srgb, var(--text) 82%, var(--text-2));
    font-size: 15.5px;
  }

  .steps li::marker {
    color: var(--text-2);
  }

  .steps li :global(.cmd) {
    margin-top: 8px;
  }

  .install-note {
    margin-top: 16px;
    font-size: 14.5px;
  }

  @media (max-width: 900px) {
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .install {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 48px;
    }

    .screen {
      margin-top: 36px;
    }

    .features {
      gap: 32px 20px;
    }
  }
</style>
