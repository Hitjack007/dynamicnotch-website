---
// A short silent loop of the real app, cut from the screen recording.
// Base.astro plays it only while it's on screen, and never with reduced motion.
interface Props {
  name: string;
  alt: string;
  width?: number;
  height?: number;
}

const { name, alt, width = 1040, height = 520 } = Astro.props;
const base = `/media/features/${name}`;
---

<div class="clip">
  <video
    data-autoplay
    muted
    loop
    playsinline
    preload="none"
    poster={`${base}.jpg`}
    width={width}
    height={height}
    aria-label={alt}
  >
    <source src={`${base}.webm`} type="video/webm" />
    <source src={`${base}.mp4`} type="video/mp4" />
  </video>
</div>

<style>
  .clip {
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: #000;
    box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.8);
  }

  video {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }
</style>
