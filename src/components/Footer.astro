<footer class="footer">
	<div class="wrap footer-inner">
		<div class="footer-info">
			<p class="footer-title">DynamicNotch</p>
			<p class="footer-note">
				A fork of <a href="https://github.com/TheBoredTeam/boring.notch" target="_blank" rel="noopener">boring.notch</a>
				by TheBoredTeam.
			</p>
			<p class="footer-note">Licensed under GPL-3.0.</p>
		</div>
		<div class="footer-links">
			<a href="https://github.com/Hitjack007/DynamicNotch" target="_blank" rel="noopener">GitHub</a>
			<a href="https://github.com/Hitjack007/DynamicNotch/releases/latest" target="_blank" rel="noopener">Releases</a>
			<a href="https://github.com/Hitjack007/DynamicNotch/blob/main/LICENSE" target="_blank" rel="noopener">License</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding: 40px 0 60px;
	}

	.footer-inner {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		flex-wrap: wrap;
		gap: 24px;
	}

	.footer-info {
		padding: 14px 20px;
		border-radius: 20px;
		background: rgba(5, 5, 5, 0.4);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-title {
		font-weight: 600;
		margin: 0 0 8px;
	}

	.footer-note {
		font-size: 13px;
		color: rgba(245, 245, 247, 0.55);
		margin: 4px 0;
	}

	.footer-note a {
		color: rgba(245, 245, 247, 0.75);
		text-decoration: underline;
	}

	.footer-links {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		font-size: 14px;
	}

	.footer-links a {
		text-decoration: none;
		opacity: 0.85;
		padding: 10px 20px;
		border-radius: 980px;
		background: rgba(5, 5, 5, 0.4);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-links a:hover {
		opacity: 1;
	}
</style>
