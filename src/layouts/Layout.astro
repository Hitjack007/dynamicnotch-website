---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'DynamicNotch — Make your MacBook\'s notch actually useful',
	description = 'DynamicNotch turns your MacBook notch into a live system dashboard — music controls, fan speeds, CPU stats, audio visualization, and smart HUD replacements.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon-32.png" sizes="32x32" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#050505" />
	</head>
	<body>
		<video id="bg-video" class="bg-video" autoplay muted loop playsinline preload="auto" poster="/video/poster.jpg">
			<source src="/video/hero.mp4" type="video/mp4" />
			<source src="/video/hero.webm" type="video/webm" />
		</video>
		<div class="bg-scrim"></div>
		<div class="page"><slot /></div>
	</body>
</html>

<script>
	function unlockVideo() {
		const video = document.querySelector('video');
		if (video && video.paused) {
			video
				.play()
				.then(() => {
					window.removeEventListener('touchstart', unlockVideo);
					window.removeEventListener('click', unlockVideo);
					window.removeEventListener('scroll', unlockVideo);
				})
				.catch((err) => {
					console.log('Playback still restricted:', err);
				});
		}
	}

	window.addEventListener('touchstart', unlockVideo, { once: true });
	window.addEventListener('click', unlockVideo, { once: true });
	window.addEventListener('scroll', unlockVideo, { once: true });
</script>

<style is:global>
	:root {
		color-scheme: dark;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: #050505;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		color: #f5f5f7;
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text',
			system-ui, sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
	}

	.bg-video {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		z-index: 0;
	}

	.bg-scrim {
		position: fixed;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(5, 5, 5, 0.15) 0%,
			rgba(5, 5, 5, 0.2) 40%,
			rgba(5, 5, 5, 0.55) 100%
		);
		z-index: 0;
	}

	.page {
		position: relative;
		z-index: 1;
	}

	.wrap {
		max-width: 1120px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.glass {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 22px;
		border-radius: 980px;
		font-size: 16px;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.15s ease, background 0.15s ease;
	}

	.btn:active {
		transform: scale(0.97);
	}

	.btn-primary {
		background: #f5f5f7;
		color: #050505;
	}

	.btn-primary:hover {
		background: #ffffff;
	}

	.btn-secondary {
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.14);
		color: #f5f5f7;
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.14);
	}
</style>
